{
  "name": "hemi-shadow-runner",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint src",
    "compile": "hardhat compile",
    "test": "hardhat test",
    "test:contract": "hardhat test",
    "test:game": "hardhat test test/ShadowRunnerGame.test.ts",
    "test:old": "hardhat test test/ShadowRunnerLeaderboard.test.ts",
    "deploy:game:testnet": "hardhat run scripts/deploy-game.cjs --network hemiSepolia",
    "deploy:game:mainnet": "hardhat run scripts/deploy-game.cjs --network hemi",
    "deploy:testnet": "hardhat run scripts/deploy.ts --network hemiSepolia",
    "deploy:mainnet": "hardhat run scripts/deploy.ts --network hemi",
    "interact:game": "hardhat run scripts/interact-game.ts --network hemiSepolia",
    "interact": "hardhat run scripts/interact.ts --network hemiSepolia",
    "leaderboard:fetch": "hardhat run scripts/fetch-leaderboard.cjs --network hemiSepolia",
    "leaderboard:fetch:mainnet": "hardhat run scripts/fetch-leaderboard.cjs --network hemi",
    "leaderboard:watch": "nodemon --watch contracts --ext sol,ts --exec \"npm run leaderboard:fetch\"",
    "index:leaderboard": "hardhat run scripts/index-leaderboard.ts --network hemiSepolia",
    "verify": "hardhat verify --network hemiSepolia",
    "verify:mainnet": "hardhat verify --network hemi",
    "prepare:mainnet": "node scripts/prepare-mainnet.cjs"
  },
  "dependencies": {
    "ethers": "^6.10.0",
    "phaser": "^3.80.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "^3.0.5",
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@nomicfoundation/hardhat-verify": "^2.0.4",
    "@openzeppelin/contracts": "^5.0.1",
    "@typechain/ethers-v6": "^0.5.1",
    "@typechain/hardhat": "^9.1.0",
    "@types/chai": "^4.3.11",
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "chai": "^4.4.1",
    "dotenv": "^16.4.1",
    "hardhat": "^2.19.5",
    "hardhat-gas-reporter": "^1.0.9",
    "oxlint": "^1.14.0",
    "solidity-coverage": "^0.8.5",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.11",
    "typechain": "^8.3.2",
    "typescript": "^5.5.3",
    "vite": "^6.0.0"
  }
}
