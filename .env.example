# Environment Variables Example
# Copy this file to .env.local for local development

# API Configuration (if you add a backend)
# VITE_API_URL=https://api.your-backend.com
# VITE_API_KEY=your-api-key

# Analytics (optional)
# VITE_GA_ID=G-XXXXXXXXXX
# VITE_PLAUSIBLE_DOMAIN=your-domain.com

# Error Tracking (optional)
# VITE_SENTRY_DSN=https://xxxxx@xxxxx.ingest.sentry.io/xxxxx

# Feature Flags (optional)
# VITE_ENABLE_LEADERBOARD=false
# VITE_ENABLE_ACHIEVEMENTS=false

# Note: The game currently doesn't require any environment variables
# for basic functionality. These are examples for future enhancements.
