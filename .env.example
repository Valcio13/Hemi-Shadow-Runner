# Environment Variables Example
# Copy this file to .env for local development

# ============================================
# SMART CONTRACT DEPLOYMENT
# ============================================

# Your wallet private key (NEVER commit this!)
# Get from MetaMask: Account Details > Export Private Key
PRIVATE_KEY=your_private_key_here

# Hemi Sepolia Testnet RPC (default provided)
HEMI_SEPOLIA_RPC=https://testnet.rpc.hemi.network/rpc

# Hemi Mainnet RPC (default provided)
HEMI_RPC=https://rpc.hemi.network/rpc

# Block explorer API key (optional for verification)
HEMI_EXPLORER_API_KEY=not-needed

# Deployed contract address (after deployment, update this)
CONTRACT_ADDRESS=

# Enable gas reporting during tests
REPORT_GAS=false

# ============================================
# FRONTEND (VITE) - Optional
# ============================================

# API Configuration (if you add a backend)
# VITE_API_URL=https://api.your-backend.com
# VITE_API_KEY=your-api-key

# Analytics (optional)
# VITE_GA_ID=G-XXXXXXXXXX
# VITE_PLAUSIBLE_DOMAIN=your-domain.com

# Error Tracking (optional)
# VITE_SENTRY_DSN=https://xxxxx@xxxxx.ingest.sentry.io/xxxxx

# Feature Flags (optional)
# VITE_ENABLE_LEADERBOARD=false
# VITE_ENABLE_ACHIEVEMENTS=false

